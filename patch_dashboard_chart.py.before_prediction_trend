# ------------------------------------------------------------
# 5. 그래프 JavaScript 추가
# ------------------------------------------------------------
chart_js = r'''
// ------------------------------------------------------------
// ACE KRX금현물 시세 추세 그래프
// ------------------------------------------------------------
let goldChartData = [];

function getAceGoldSeries(data) {
    const series = data?.series?.ACE_KRX_GOLD;

    if (!Array.isArray(series)) {
        return [];
    }

    return series
        .filter(item =>
            item &&
            item.timestamp &&
            item.price != null &&
            Number.isFinite(Number(item.price))
        )
        .map(item => ({
            timestamp: item.timestamp,
            price: Number(item.price)
        }))
        .sort((a, b) =>
            new Date(a.timestamp) - new Date(b.timestamp)
        );
}

function formatChartTime(timestamp) {
    const date = new Date(timestamp);

    if (Number.isNaN(date.getTime())) {
        return "";
    }

    return date.toLocaleTimeString("ko-KR", {
        hour: "2-digit",
        minute: "2-digit"
    });
}

function formatChartDateTime(timestamp) {
    const date = new Date(timestamp);

    if (Number.isNaN(date.getTime())) {
        return timestamp;
    }

    return date.toLocaleString("ko-KR", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false
    });
}

function drawAceGoldChart(data) {
    const canvas = document.getElementById("goldChart");
    const empty = document.getElementById("goldChartEmpty");
    const info = document.getElementById("goldChartInfo");

    if (!canvas) {
        return;
    }

    const series = getAceGoldSeries(data);
    goldChartData = series;

    if (!series.length) {
        canvas.style.display = "none";

        if (empty) {
            empty.style.display = "flex";
        }

        if (info) {
            info.textContent = "데이터 없음";
        }

        return;
    }

    canvas.style.display = "block";

    if (empty) {
        empty.style.display = "none";
    }

    const container = canvas.parentElement;

    const width = container.clientWidth;
    const height = container.clientHeight;

    const dpr = window.devicePixelRatio || 1;

    canvas.width = width * dpr;
    canvas.height = height * dpr;

    canvas.style.width = width + "px";
    canvas.style.height = height + "px";

    const ctx = canvas.getContext("2d");

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // 여백
    const padding = {
        top: 20,
        right: 30,
        bottom: 42,
        left: 72
    };

    const chartWidth =
        width - padding.left - padding.right;

    const chartHeight =
        height - padding.top - padding.bottom;

    if (chartWidth <= 0 || chartHeight <= 0) {
        return;
    }

    // 가격 범위
    const prices = series.map(item => item.price);

    let minPrice = Math.min(...prices);
    let maxPrice = Math.max(...prices);

    if (minPrice === maxPrice) {
        minPrice -= 10;
        maxPrice += 10;
    }

    const range = maxPrice - minPrice;

    // 그래프 상하 여유
    minPrice -= range * 0.08;
    maxPrice += range * 0.08;

    const x = index => {
        if (series.length === 1) {
            return padding.left + chartWidth / 2;
        }

        return padding.left +
            (index / (series.length - 1)) * chartWidth;
    };

    const y = price =>
        padding.top +
        (maxPrice - price) /
        (maxPrice - minPrice) *
        chartHeight;

    // 배경
    ctx.clearRect(0, 0, width, height);

    // --------------------------------------------------------
    // Grid
    // --------------------------------------------------------
    ctx.font = "12px -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif";
    ctx.textAlign = "right";
    ctx.textBaseline = "middle";

    const gridCount = 5;

    for (let i = 0; i <= gridCount; i++) {
        const ratio = i / gridCount;
        const price =
            maxPrice -
            ratio * (maxPrice - minPrice);

        const yy =
            padding.top +
            ratio * chartHeight;

        ctx.beginPath();
        ctx.moveTo(padding.left, yy);
        ctx.lineTo(width - padding.right, yy);

        ctx.strokeStyle = "#edf0f5";
        ctx.lineWidth = 1;
        ctx.stroke();

        ctx.fillStyle = "#667085";

        ctx.fillText(
            Math.round(price).toLocaleString("ko-KR"),
            padding.left - 10,
            yy
        );
    }

    // --------------------------------------------------------
    // X축 시간
    // --------------------------------------------------------
    ctx.textAlign = "center";
    ctx.textBaseline = "top";

    const xLabelCount = Math.min(6, series.length);

    for (let i = 0; i < xLabelCount; i++) {
        const index =
            Math.round(
                i *
                (series.length - 1) /
                Math.max(1, xLabelCount - 1)
            );

        const xx = x(index);

        ctx.fillStyle = "#667085";

        ctx.fillText(
            formatChartTime(series[index].timestamp),
            xx,
            height - padding.bottom + 12
        );
    }

    // --------------------------------------------------------
    // Line
    // --------------------------------------------------------
    ctx.beginPath();

    series.forEach((item, index) => {
        const xx = x(index);
        const yy = y(item.price);

        if (index === 0) {
            ctx.moveTo(xx, yy);
        } else {
            ctx.lineTo(xx, yy);
        }
    });

    ctx.strokeStyle = "#2563eb";
    ctx.lineWidth = 2.5;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.stroke();

    // --------------------------------------------------------
    // 최신 가격 점
    // --------------------------------------------------------
    const latest = series[series.length - 1];

    const latestX = x(series.length - 1);
    const latestY = y(latest.price);

    ctx.beginPath();
    ctx.arc(latestX, latestY, 5, 0, Math.PI * 2);

    ctx.fillStyle = "#2563eb";
    ctx.fill();

    ctx.beginPath();
    ctx.arc(latestX, latestY, 9, 0, Math.PI * 2);

    ctx.strokeStyle = "rgba(37,99,235,.18)";
    ctx.lineWidth = 4;
    ctx.stroke();

    // --------------------------------------------------------
    // 정보
    // --------------------------------------------------------
    if (info) {
        info.textContent =
            `${series.length.toLocaleString("ko-KR")}개 데이터 · ` +
            `최근 ${latest.price.toLocaleString("ko-KR")}원 · ` +
            `${formatChartDateTime(latest.timestamp)}`;
    }
}

// ------------------------------------------------------------
// 그래프 반응형 처리
// ------------------------------------------------------------
let goldChartResizeTimer = null;

window.addEventListener("resize", () => {
    clearTimeout(goldChartResizeTimer);

    goldChartResizeTimer = setTimeout(() => {
        if (goldChartData.length) {
            drawAceGoldChart({
                series: {
                    ACE_KRX_GOLD: goldChartData
                }
            });
        }
    }, 150);
});
'''

# render(d) 내부에서 그래프를 그리도록 추가
render_marker = 'function render(d){'

if chart_js.strip() not in content:
