        for symbol, quote in self.latest_quotes.items():
            if symbol == self.DEFAULT_SYMBOLS[0]:
                krw_price = (quote.price * fx_rate).quantize(Decimal("0.01"))
                latest_quotes[symbol] = {
                    "price_usd": float(quote.price),
