function findP(d,keys){const roots=[d.predictions,d.prediction?.horizons,d.prediction];for(const root of roots){if(!root||typeof root!=="object")continue;for(const k of keys)if(root[k]&&typeof root[k]==="object")return root[k]}return null}
function findModelMetrics(d){
  const candidates=[
    d?.prediction?.model_metrics,
