const API_URL="/api/dashboard-data";
function fmt(v,d=2){if(v==null||Number.isNaN(Number(v)))return"-";return Number(v).toLocaleString("ko-KR",{minimumFractionDigits:d,maximumFractionDigits:d})}
function fmtTime(v){if(!v)return"-";const d=new Date(v);return Number.isNaN(d.getTime())?v:d.toLocaleString("ko-KR",{hour12:false})}
function setText(id,v){const e=document.getElementById(id);if(e)e.textContent=v}
