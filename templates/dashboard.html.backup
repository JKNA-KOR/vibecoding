<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vibecoding Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #101820;
      color: #f8f9fa;
    }
    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px;
    }
    .section {
      margin-bottom: 24px;
      background: #161b22;
      border: 1px solid #2f3542;
      border-radius: 16px;
      padding: 20px;
    }
    h1, h2 {
      margin: 0 0 12px;
      font-weight: 700;
      color: #ffffff;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-bottom: 16px;
    }
    .card {
      padding: 18px;
      border-radius: 16px;
      background: linear-gradient(180deg, #1f2937 0%, #111827 100%);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }
    .card.pred-bull { background: linear-gradient(180deg, #4c1d95 0%, #7c2d12 100%); }
    .card.pred-bear { background: linear-gradient(180deg, #0f172a 0%, #0f3466 100%); }
    .card.pred-neutral { background: linear-gradient(180deg, #1f2937 0%, #111827 100%); }
    .card strong {
      display: block;
      font-size: 0.95rem;
      margin-bottom: 8px;
      color: #a5b4fc;
    }
    .card .value {
      font-size: 1.8rem;
      font-weight: 700;
      color: #f8f9fa;
    }
    canvas {
      width: 100% !important;
      max-height: 320px;
    }
    .charts-row {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }
    .chart-card {
      flex: 1 1 480px;
      background: transparent;
      padding: 12px 8px;
      border-radius: 12px;
    }
    .gap-card {
      flex: 0 0 260px;
      background: transparent;
      padding: 12px 8px;
      border-radius: 12px;
    }
    .status {
      margin-top: 12px;
      font-size: 0.95rem;
      color: #cbd5e1;
      white-space: pre-line;
    }
  </style>
</head>
<body>
  <div class="page">
    <h1>Vibecoding GOLD Forecast Dashboard</h1>
    <div class="section">
      <div class="cards">
        <div class="card">
          <strong>마이크로섹터 금광3배 ETN</strong>
          <div class="value" id="price-microsector">--</div>
          <div class="status" id="fx-microsector">-</div>
          <div class="status" id="time-microsector">-</div>
        </div>
        <div class="card">
          <strong>ACE KRX금현물</strong>
          <div class="value" id="price-ace">--</div>
          <div class="status" id="time-ace">-</div>
        </div>
        <div class="card" id="card-prediction">
          <strong>금현물 예측</strong>
          <div class="value" id="price-prediction">--</div>
          <div class="status" id="signal-prediction">--</div>
          <div class="status" id="gap-prediction">-</div>
          <div class="status" id="gap-desc-prediction">-</div>
          <div style="margin-top:8px; display:flex; gap:8px; align-items:center;">
            <label style="font-size:0.85rem; color:#cbd5e1;">+임계:</label>
            <input id="gap-pos-thresh" type="number" step="0.1" min="0" style="width:72px; padding:6px; border-radius:6px; border:1px solid #2f3542; background:#0b1220; color:#f8f9fa;" />
            <label style="font-size:0.85rem; color:#cbd5e1;">-임계:</label>
            <input id="gap-neg-thresh" type="number" step="0.1" min="0" style="width:72px; padding:6px; border-radius:6px; border:1px solid #2f3542; background:#0b1220; color:#f8f9fa;" />
          </div>
        </div>
      </div>
      <div class="status">데이터는 1개월치 이상 로드되며, 5분마다 갱신됩니다.</div>
    </div>

    <div class="section charts-row">
      <div class="chart-card">
        <h2>가격 추이</h2>
        <canvas id="priceChart"></canvas>
      </div>
      <div class="chart-card">
        <h2>ACE KRX금현물 예측</h2>
        <canvas id="predictionChart"></canvas>
      </div>
      <div class="gap-card">
        <h2>갭% 추이</h2>
        <canvas id="gapChart" style="max-height:160px;"></canvas>
        <div id="stale-warnings" class="status" style="margin-top:8px; color:#fca5a5;"></div>
      </div>
    </div>
  </div>

  <script>
    const priceChartCtx = document.getElementById('priceChart').getContext('2d');
    const predictionChartCtx = document.getElementById('predictionChart').getContext('2d');

    const priceChart = new Chart(priceChartCtx, {
      type: 'line',
      data: {
        labels: [],
        datasets: [
          {
            label: '마이크로섹터 금광3배 ETN (KRW/10)',
            borderColor: '#f59e0b',
            backgroundColor: 'rgba(245, 158, 11, 0.2)',
            tension: 0.3,
            borderWidth: 3,
            pointRadius: 4,
            pointHoverRadius: 6,
            showLine: true,
            fill: false,
            spanGaps: true,
            yAxisID: 'y1',
            data: [],
          },
          {
            label: 'ACE KRX금현물',
            borderColor: '#38bdf8',
            backgroundColor: 'rgba(56, 189, 248, 0.2)',
            tension: 0.3,
            borderWidth: 3,
            pointRadius: 4,
            pointHoverRadius: 6,
            showLine: true,
            fill: false,
            spanGaps: true,
            yAxisID: 'y',
            data: [],
          },
        ],
      },
      options: {
        responsive: true,
        interaction: {
          mode: 'index',
          intersect: false,
        },
        plugins: {
          legend: { labels: { color: '#f8f9fa' } },
          tooltip: {
            callbacks: {
              label: function(context) {
                const label = context.dataset.label || '';
                const value = context.parsed.y;
                return `${label}: ${value.toLocaleString()}${context.dataset.yAxisID === 'y1' ? ' KRW/10' : ' KRW'}`;
              }
            }
          }
        },
        scales: {
          x: {
            ticks: { color: '#cbd5e1', maxTicksLimit: 6, autoSkip: true, callback: function(value, index, ticks) { try { const label = this.getLabelForValue(value); const d = new Date(label); const mo = String(d.getMonth()+1).padStart(2,'0'); const day = String(d.getDate()).padStart(2,'0'); const hh = String(d.getHours()).padStart(2,'0'); const mm = String(d.getMinutes()).padStart(2,'0'); return `${mo}/${day} ${hh}시 ${mm}분`; } catch(e) { return value; } } },
            grid: { color: 'rgba(255,255,255,0.08)' }
          },
          y: {
            position: 'left',
            title: { display: true, text: 'ACE KRX금현물 (KRW)', color: '#38bdf8' },
            ticks: { color: '#cbd5e1', callback: function(value) { return value.toLocaleString(); } },
            grid: { color: 'rgba(255,255,255,0.08)' },
          },
          y1: {
            position: 'right',
            title: { display: true, text: '금광3배 ETN (KRW/10)', color: '#f59e0b' },
            ticks: { color: '#cbd5e1', callback: function(value) { return value.toLocaleString(); } },
            grid: { drawOnChartArea: false },
          },
        },
      },
    });

    const predictionChart = new Chart(predictionChartCtx, {
      type: 'line',
      data: {
        labels: [],
        datasets: [
          {
            label: 'ACE KRX금현물 실제 가격',
            borderColor: '#38bdf8',
            backgroundColor: 'rgba(56, 189, 248, 0.2)',
            tension: 0.3,
            data: [],
          },
          {
            label: 'ACE KRX금현물 예측 가격',
            borderColor: '#a78bfa',
            backgroundColor: 'rgba(167, 139, 250, 0.2)',
            tension: 0.3,
            borderDash: [6, 4],
            data: [],
          },
        ],
      },
      options: {
        responsive: true,
        interaction: {
          mode: 'index',
          intersect: false,
        },
        plugins: {
          legend: { labels: { color: '#f8f9fa' } },
        },
        scales: {
          x: {
            ticks: { color: '#cbd5e1', maxTicksLimit: 6, autoSkip: true, callback: function(value, index, ticks) { try { const label = this.getLabelForValue(value); const d = new Date(label); const mo = String(d.getMonth()+1).padStart(2,'0'); const day = String(d.getDate()).padStart(2,'0'); const hh = String(d.getHours()).padStart(2,'0'); const mm = String(d.getMinutes()).padStart(2,'0'); return `${mo}/${day} ${hh}시 ${mm}분`; } catch(e) { return value; } } },
            grid: { color: 'rgba(255,255,255,0.08)' }
          },
          y: { ticks: { color: '#cbd5e1' }, grid: { color: 'rgba(255,255,255,0.08)' } },
        },
      },
    });

    const gapChartCtx = document.getElementById('gapChart').getContext('2d');
    const gapChart = new Chart(gapChartCtx, {
      type: 'line',
      data: {
        labels: [],
        datasets: [
          {
            label: '갭% (Spot - ETF, %)',
            borderColor: '#f87171',
            backgroundColor: 'rgba(248,113,113,0.15)',
            tension: 0.3,
            borderWidth: 2,
            pointRadius: 2,
            data: [],
          },
          {
            label: '예측 갭%',
            borderColor: '#a78bfa',
            backgroundColor: 'rgba(167,139,250,0.15)',
            tension: 0.3,
            borderDash: [4,4],
            pointRadius: 4,
            data: [],
            showLine: false,
            fill: false,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { labels: { color: '#f8f9fa', boxWidth: 8 } } },
        scales: {
          x: { display: false },
          y: { ticks: { color: '#cbd5e1' }, grid: { color: 'rgba(255,255,255,0.06)' } },
        },
      },
    });

    let lastDashboardData = null;

    function loadUIThresholds(serverThresholds) {
      const posInput = document.getElementById('gap-pos-thresh');
      const negInput = document.getElementById('gap-neg-thresh');
      const storedPos = localStorage.getItem('gap_pos');
      const storedNeg = localStorage.getItem('gap_neg');
      let pos, neg;
      if (storedPos !== null) {
        pos = Number(storedPos);
        posInput.value = pos;
      } else {
        pos = (serverThresholds && serverThresholds.positive) ? serverThresholds.positive : 1.0;
        posInput.value = pos;
      }
      if (storedNeg !== null) {
        neg = Number(storedNeg);
        negInput.value = neg;
      } else {
        neg = (serverThresholds && serverThresholds.negative_abs) ? serverThresholds.negative_abs : 1.0;
        negInput.value = neg;
      }
      return { positive: Number(pos), negative_abs: Number(neg) };
    }

    function saveUIThresholds() {
      const posInput = document.getElementById('gap-pos-thresh');
      const negInput = document.getElementById('gap-neg-thresh');
      localStorage.setItem('gap_pos', posInput.value);
      localStorage.setItem('gap_neg', negInput.value);
    }

    function applyThresholdsToUI(data) {
      if (!data) return;
      const thresholds = loadUIThresholds(data.prediction.gap_thresholds || { positive: 1.0, negative_abs: 1.0 });
      const gap = data.prediction.gap_percent;
      const card = document.getElementById('card-prediction');
      card.classList.remove('pred-bull', 'pred-bear', 'pred-neutral');
      if (gap !== null && gap !== undefined) {
        if (gap >= thresholds.positive) {
          card.classList.add('pred-bull');
        } else if (gap <= -thresholds.negative_abs) {
          card.classList.add('pred-bear');
        } else {
          card.classList.add('pred-neutral');
        }
        document.getElementById('gap-desc-prediction').textContent = `갭 ${gap}%: ${gap >= thresholds.positive ? '과도한 강세' : (gap <= -thresholds.negative_abs ? '과도한 약세' : '중립')}`;
      } else {
        card.classList.add('pred-neutral');
        document.getElementById('gap-desc-prediction').textContent = data.prediction.gap_description || '-';
      }
    }

    document.getElementById('gap-pos-thresh').addEventListener('change', () => { saveUIThresholds(); applyThresholdsToUI(lastDashboardData); });
    document.getElementById('gap-neg-thresh').addEventListener('change', () => { saveUIThresholds(); applyThresholdsToUI(lastDashboardData); });

    async function fetchDashboardData() {
      try {
        const response = await fetch('/api/dashboard-data');
        if (!response.ok) {
          throw new Error('데이터를 불러오는 동안 문제가 발생했습니다.');
        }

        const data = await response.json();
        const microData = data.series.MICROSECTOR_GOLD3X || [];
        const aceData = data.series.ACE_KRX_GOLD || [];

        const allTimestamps = Array.from(new Set([
          ...microData.map(point => point.timestamp),
          ...aceData.map(point => point.timestamp),
        ])).sort();

        priceChart.data.labels = allTimestamps;
        priceChart.data.datasets[0].data = allTimestamps.map(label => {
          const point = microData.find(item => item.timestamp === label);
          return point ? point.price : null;
        });
        priceChart.data.datasets[1].data = allTimestamps.map(label => {
          const point = aceData.find(item => item.timestamp === label);
          return point ? point.price : null;
        });
        priceChart.update();

        const predictionData = aceData.map(point => ({ x: point.timestamp, y: point.price }));
        const predictionPoint = data.prediction.future_point ? [{ x: data.prediction.future_point.timestamp, y: data.prediction.future_point.price }] : [];
        predictionChart.data.labels = [...predictionData.map(item => item.x), ...predictionPoint.map(item => item.x)];
        predictionChart.data.datasets[0].data = predictionData;
        predictionChart.data.datasets[1].data = predictionPoint;
        predictionChart.update();

        if (microData.length) {
          const fxRate = data.fx_rate.toLocaleString(undefined, { maximumFractionDigits: 2 });
          const latestMicro = data.latest_quotes['마이크로섹터 금광3배 ETN'];
          const usdPrice = latestMicro ? Number(latestMicro.price_usd).toLocaleString() : '--';
          const krwPrice = latestMicro ? Number(latestMicro.krw_price).toLocaleString() : '--';
          document.getElementById('price-microsector').innerHTML = `${usdPrice} USD<br>(${krwPrice} KRW)`;
          document.getElementById('fx-microsector').innerHTML = `환율 ${fxRate} KRW<br>환산가 ${krwPrice} KRW`;
        } else {
          document.getElementById('price-microsector').textContent = '--';
          document.getElementById('fx-microsector').textContent = '-';
        }
        document.getElementById('time-microsector').textContent = microData.length ? new Date(microData[microData.length - 1].timestamp).toLocaleString() : '-';
        document.getElementById('price-ace').textContent = aceData.length ? `${aceData[aceData.length - 1].price.toLocaleString()} KRW` : '--';
        document.getElementById('time-ace').textContent = aceData.length ? new Date(aceData[aceData.length - 1].timestamp).toLocaleString() : '-';
        document.getElementById('price-prediction').textContent = data.prediction.predicted_price ? `${data.prediction.predicted_price.toLocaleString()} KRW` : '--';
        document.getElementById('signal-prediction').textContent = data.prediction.recommendation + ' / ' + data.prediction.reason;
        if (data.prediction.gap_percent !== null && data.prediction.gap_percent !== undefined) {
          const gapText = `${data.prediction.gap_percent > 0 ? '+' : ''}${data.prediction.gap_percent}%`;
          document.getElementById('gap-prediction').textContent = `갭 ${gapText}`;
        } else {
          document.getElementById('gap-prediction').textContent = '-';
        }
        // store last data and apply UI thresholds (persisted if set)
        lastDashboardData = data;
        applyThresholdsToUI(data);
        // gap chart data
        const gapSeries = data.gap_realtime_series && data.gap_realtime_series.length ? data.gap_realtime_series : (data.gap_series || []);
        gapChart.data.labels = gapSeries.map(p => p.timestamp);
        gapChart.data.datasets[0].data = gapSeries.map(p => p.gap_percent);
        // predicted gap point
        if (data.predicted_gap_point) {
          gapChart.data.datasets[1].data = [{ x: data.predicted_gap_point.timestamp, y: data.predicted_gap_point.gap_percent }];
        } else {
          gapChart.data.datasets[1].data = [];
        }
        gapChart.update();
        // render stale warnings (no price change for configured minutes)
        const staleEl = document.getElementById('stale-warnings');
        if (data.stale_warnings) {
          const msgs = [];
          for (const [sym, info] of Object.entries(data.stale_warnings)) {
            if (info && info.is_stale && info.message) msgs.push(info.message);
          }
          staleEl.textContent = msgs.length ? msgs.join('\n') : '';
        } else {
          staleEl.textContent = '';
        }
        // ensure UI threshold inputs reflect initial server thresholds if localStorage empty
        loadUIThresholds(data.prediction.gap_thresholds || { positive: 1.0, negative_abs: 1.0 });
      } catch (error) {
        console.error(error);
      }
    }

    fetchDashboardData();
    setInterval(fetchDashboardData, 5 * 60 * 1000);
  </script>
</body>
</html>
